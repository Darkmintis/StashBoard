{
  "name": "stashboard",
  "displayName": "StashBoard",
  "description": "Named, safe stashes for your unfinished git work. Save changes aside, browse them on a drag-and-drop board, and restore them — built on git stash.",
  "version": "0.1.0",
  "publisher": "darkmintis",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "stash",
    "scm",
    "source control",
    "wip"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Darkmintis/StashBoard",
    "directory": "packages/extension"
  },
  "bugs": "https://github.com/Darkmintis/StashBoard/issues",
  "homepage": "https://github.com/Darkmintis/StashBoard#readme",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stashboard",
          "title": "StashBoard",
          "icon": "assets/stashboard.svg"
        }
      ]
    },
    "views": {
      "stashboard": [
        {
          "type": "webview",
          "id": "stashboard.board",
          "name": "Stash Board",
          "icon": "assets/stashboard.svg",
          "contextualTitle": "Stash Board"
        }
      ]
    },
    "commands": [
      {
        "command": "stashboard.openBoard",
        "title": "Open Board",
        "category": "StashBoard",
        "icon": "$(window)"
      },
      {
        "command": "stashboard.focusSidebar",
        "title": "Focus Sidebar Board",
        "category": "StashBoard"
      },
      {
        "command": "stashboard.save",
        "title": "Save Selected Files to Stash...",
        "category": "StashBoard"
      },
      {
        "command": "stashboard.restore",
        "title": "Restore Stash",
        "category": "StashBoard"
      },
      {
        "command": "stashboard.stage",
        "title": "Restore Stash to Staged",
        "category": "StashBoard"
      },
      {
        "command": "stashboard.preview",
        "title": "Preview Stash",
        "category": "StashBoard"
      },
      {
        "command": "stashboard.rename",
        "title": "Rename Stash",
        "category": "StashBoard"
      },
      {
        "command": "stashboard.delete",
        "title": "Delete Stash",
        "category": "StashBoard"
      },
      {
        "command": "stashboard.openFile",
        "title": "Open File in Stash",
        "category": "StashBoard"
      },
      {
        "command": "stashboard.saveAll",
        "title": "Save All Changes to Stash",
        "category": "StashBoard"
      },
      {
        "command": "stashboard.refresh",
        "title": "Refresh",
        "category": "StashBoard",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stashboard.openBoard",
          "when": "view == stashboard.board",
          "group": "navigation@1"
        },
        {
          "command": "stashboard.refresh",
          "when": "view == stashboard.board",
          "group": "navigation@2"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "stashboard.saveAll",
          "when": "scmProvider == stashboard",
          "group": "1_stashboard@1"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "stashboard.save",
          "when": "scmProvider == git",
          "group": "2_stashboard@1"
        },
        {
          "command": "stashboard.openFile",
          "when": "scmProvider == stashboard",
          "group": "inline@1"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "stashboard.restore",
          "when": "scmProvider == stashboard",
          "group": "1_stashboard@1"
        },
        {
          "command": "stashboard.stage",
          "when": "scmProvider == stashboard",
          "group": "1_stashboard@2"
        },
        {
          "command": "stashboard.preview",
          "when": "scmProvider == stashboard",
          "group": "2_stashboard@1"
        },
        {
          "command": "stashboard.rename",
          "when": "scmProvider == stashboard",
          "group": "2_stashboard@2"
        },
        {
          "command": "stashboard.delete",
          "when": "scmProvider == stashboard",
          "group": "3_stashboard@1"
        }
      ],
      "commandPalette": [
        {
          "command": "stashboard.openFile",
          "when": "false"
        },
        {
          "command": "stashboard.focusSidebar",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.3"
  }
}
